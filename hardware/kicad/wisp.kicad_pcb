	(footprint "ESP32-S3-WROOM-1"
		(layer "F.Cu")
		(uuid "c6ecfc89-07d0-4a9a-b320-f8520c1396c2")
		(at 30 13.5)
		(descr "Espressif ESP32-S3-WROOM-1. Project-local copy of the stock KiCad footprint with ONE change: the courtyard is trimmed to the module body (x -9.75..9.75, y -12.75..13.45) instead of the stock 48 x 41mm. The stock courtyard applies Espressif's 15mm antenna clearance symmetrically around the whole module, which swallows a third of a 60x80mm board and produces courtyard-overlap DRC errors against parts nowhere near the module. The footprint's own antenna keepout zone is removed as well, so the board carries a single deliberate antenna rule area along the top edge instead of two overlapping ones. See hardware/README.md.")
		(tags "2.4 GHz Wi-Fi and Bluetooth module")
