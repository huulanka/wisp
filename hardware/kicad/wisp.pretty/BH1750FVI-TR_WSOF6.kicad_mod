(footprint "BH1750FVI-TR_WSOF6"
	(version 20251024)
	(generator "wisp")
	(generator_version "10.0")
	(layer "F.Cu")
	(descr "ROHM BH1750FVI-TR, WSOF6I package, 0.5mm pitch. Land pattern derived from ROHM's BH1750FVI Technical Note (No.11046EDT01, Rev.D, 2011.11), p.14 Package Outlines: body 1.6+/-0.1 x 2.6+/-0.1mm (3.0+/-0.1mm overall incl. leads), 0.5mm pitch, lead width 0.22+/-0.05mm, lead foot length 0.27+/-0.05mm. Cross-checked against the LCSC C78960 (ROHM BH1750FVI-TR, WSOF-6, confirmed matching part) EasyEDA-generated footprint, whose pad pitch (0.5mm) and size (0.508 x 0.1778mm at +/-1.5508mm row spacing, axes rotated 90deg into this footprint's convention) agree with the datasheet figure. Pad 7 is the exposed centre pad; per the datasheet p.16 'Cautions on use' item 10 it must NOT be soldered or electrically connected -- it is internally at GND potential and an external connection risks malfunction/heavy current. It is included here as copper only (no solder paste, no net) for mechanical registration.")
	(tags "BH1750 WSOF6 ambient light sensor")
	(attr smd)
	(property "Reference" "REF**"
		(at 0 -2.2 0)
		(layer "F.SilkS")
		(effects (font (size 1 1) (thickness 0.15)))
	)
	(property "Value" "BH1750FVI-TR"
