(version 1)

# U5 (BME680, LGA-8, 0.8mm pitch) is too tight for the board-wide 0.6mm
# minimum via diameter: a 0.6mm via cannot clear neighboring pads at 0.8mm
# pitch without sitting on top of one of them. This exception allows a
# smaller via (0.45mm dia / 0.2mm drill, still within JLCPCB standard
# capability) only for vias placed under U5's own courtyard, so the +3V3
# via feeding pin 2 can sit off-pad instead of via-in-pad. See
# hardware/README.md for the full writeup and the two known,
# reviewed-as-acceptable clearance shortfalls this leaves under U5.
(rule "U5 local via size exception"
	(condition "A.insideCourtyard('U5')")
	(constraint via_diameter (min 0.4mm))
	(constraint hole_size (min 0.2mm))
)
